{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "7209609305587945093"
    }
  },
  "parameters": {
    "application": {
      "type": "string",
      "metadata": {
        "description": "The Radius application ID that owns this container."
      }
    },
    "name": {
      "type": "string",
      "metadata": {
        "description": "Logical service name and Radius container resource name."
      }
    },
    "image": {
      "type": "string",
      "metadata": {
        "description": "Container image reference for the service."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "global",
      "metadata": {
        "description": "Radius resource location."
      }
    },
    "containerPort": {
      "type": "int",
      "defaultValue": 8080,
      "metadata": {
        "description": "Primary HTTP port exposed by the service."
      }
    },
    "env": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Environment variables to inject into the container."
      }
    },
    "connections": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Radius connections to supporting services or Dapr components."
      }
    },
    "enableDapr": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether to enable a Dapr sidecar for the service."
      }
    },
    "daprAppId": {
      "type": "string",
      "defaultValue": "[parameters('name')]",
      "metadata": {
        "description": "Dapr app ID for the service."
      }
    },
    "daprAppPort": {
      "type": "int",
      "defaultValue": "[parameters('containerPort')]",
      "metadata": {
        "description": "Port exposed to the Dapr sidecar."
      }
    },
    "podLabels": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional pod-level labels to apply to Kubernetes pods generated by Radius. Required by AKS Workload Identity webhook (azure.workload.identity/use: \"true\")."
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Image pull secrets to attach to the pod spec. Each entry must be an object with a name property (e.g. [{name: \"ghcr-pull-secret\"}])."
      }
    }
  },
  "variables": {
    "podSpec": "[if(not(empty(parameters('imagePullSecrets'))), createObject('spec', createObject('imagePullSecrets', parameters('imagePullSecrets'))), createObject())]",
    "podConfig": "[union(if(not(empty(parameters('podLabels'))), createObject('labels', parameters('podLabels')), createObject()), variables('podSpec'))]"
  },
  "imports": {
    "radius": {
      "provider": "Radius",
      "version": "0.55"
    }
  },
  "resources": {
    "service": {
      "import": "radius",
      "type": "Applications.Core/containers@2023-10-01-preview",
      "properties": {
        "name": "[parameters('name')]",
        "location": "[parameters('location')]",
        "properties": {
          "application": "[parameters('application')]",
          "container": {
            "image": "[parameters('image')]",
            "env": "[parameters('env')]",
            "ports": {
              "http": {
                "containerPort": "[parameters('containerPort')]",
                "protocol": "TCP"
              }
            }
          },
          "connections": "[parameters('connections')]",
          "extensions": "[if(parameters('enableDapr'), createArray(createObject('kind', 'daprSidecar', 'appId', parameters('daprAppId'), 'appPort', parameters('daprAppPort'))), createArray())]",
          "runtimes": "[if(not(empty(variables('podConfig'))), createObject('kubernetes', createObject('pod', variables('podConfig'))), createObject())]"
        }
      }
    }
  },
  "outputs": {
    "id": {
      "type": "string",
      "value": "[reference('service').id]"
    }
  }
}