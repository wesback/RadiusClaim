{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "13416486747756090361"
    }
  },
  "parameters": {
    "context": {
      "type": "object",
      "metadata": {
        "description": "Radius-provided object containing information about the resource calling the Recipe."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure location for the backing state store resources."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(format('ce{0}', take(uniqueString(parameters('context').resource.id, 'storage'), 20)))]",
      "metadata": {
        "description": "Storage account name for the Azure Blob-backed Dapr state store."
      }
    },
    "containerName": {
      "type": "string",
      "defaultValue": "expense-state",
      "metadata": {
        "description": "Blob container name used by the Dapr state store component."
      }
    },
    "storageSku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "metadata": {
        "description": "Storage SKU for the backing Azure Storage account."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('storageSku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', parameters('storageAccountName'), 'default', parameters('containerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
      ]
    }
  ],
  "outputs": {
    "result": {
      "type": "object",
      "value": {
        "values": {
          "type": "state.azure.blobstorage",
          "version": "v2",
          "metadata": {
            "accountName": {
              "value": "[parameters('storageAccountName')]"
            },
            "containerName": {
              "value": "[parameters('containerName')]"
            }
          }
        },
        "secrets": {
          "metadata": {
            "accountKey": {
              "value": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value]"
            }
          }
        }
      }
    }
  }
}