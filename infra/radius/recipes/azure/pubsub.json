{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "12021420559950196974"
    }
  },
  "parameters": {
    "context": {
      "type": "object",
      "metadata": {
        "description": "Radius-provided object containing information about the resource calling the Recipe."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure location for the backing Service Bus resources."
      }
    },
    "namespaceName": {
      "type": "string",
      "defaultValue": "[format('radiusclaim-{0}', take(uniqueString(parameters('context').resource.id, 'servicebus'), 18))]",
      "metadata": {
        "description": "Service Bus namespace name for the Azure-backed Dapr pub/sub component."
      }
    },
    "topicName": {
      "type": "string",
      "defaultValue": "expense-notifications",
      "metadata": {
        "description": "Topic used by the RadiusClaim notification flow."
      }
    },
    "subscriptionName": {
      "type": "string",
      "defaultValue": "notification-svc",
      "metadata": {
        "description": "Subscription pre-created for the RadiusClaim notification subscriber when entity management stays disabled."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Standard"
      ],
      "metadata": {
        "description": "Service Bus SKU used for the demo namespace."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.ServiceBus/namespaces",
      "apiVersion": "2024-01-01",
      "name": "[parameters('namespaceName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "[parameters('skuName')]",
        "capacity": 1
      },
      "properties": {
        "minimumTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.ServiceBus/namespaces/topics",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', parameters('namespaceName'), parameters('topicName'))]",
      "properties": {
        "enableBatchedOperations": true,
        "maxSizeInMegabytes": 1024
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces', parameters('namespaceName'))]"
      ]
    },
    {
      "type": "Microsoft.ServiceBus/namespaces/topics/subscriptions",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}/{2}', parameters('namespaceName'), parameters('topicName'), parameters('subscriptionName'))]",
      "properties": {
        "deadLetteringOnMessageExpiration": true,
        "maxDeliveryCount": 10
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces/topics', parameters('namespaceName'), parameters('topicName'))]"
      ]
    }
  ],
  "outputs": {
    "result": {
      "type": "object",
      "value": {
        "values": {
          "type": "pubsub.azure.servicebus.topics",
          "version": "v1",
          "metadata": {
            "namespaceName": {
              "value": "[format('{0}.servicebus.windows.net', parameters('namespaceName'))]"
            },
            "disableEntityManagement": {
              "value": "true"
            }
          }
        },
        "secrets": {
          "metadata": {
            "connectionString": {
              "value": "[listKeys(resourceId('Microsoft.ServiceBus/namespaces/AuthorizationRules', parameters('namespaceName'), 'RootManageSharedAccessKey'), '2024-01-01').primaryConnectionString]"
            }
          }
        }
      }
    }
  }
}