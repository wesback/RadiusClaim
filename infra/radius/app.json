                  "connections": "[parameters('connections')]",
                  "extensions": "[if(parameters('enableDapr'), createArray(createObject('kind', 'daprSidecar', 'appId', parameters('daprAppId'), 'appPort', parameters('daprAppPort'))), createArray())]"
                }
              }
            }
          },
          "outputs": {
