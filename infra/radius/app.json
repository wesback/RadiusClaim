        "kind": "HTTP",
        "hostnames": "[variables('publicRouteHostnames')]",
        "rules": [
          {
            "matches": [
              {
                "httpPath": "/"
              }
            ],
            "destinationContainer": {
              "resourceId": "[reference('expenseApi').outputs.id.value]",
              "containerName": "expense-api",
              "containerPort": "[variables('servicePort')]"
            }
          }
        ]
      },
      "dependsOn": [
        "app",
        "expenseApi"
      ]
    },
