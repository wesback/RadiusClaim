          "type": "[variables('pubsubBacking').type]",
          "version": "[variables('pubsubBacking').version]",
          "metadata": {
            "namespaceName": {
              "value": "[variables('pubsubNamespaceName')]"
            },
            "disableEntityManagement": {
              "value": "true"
            }
          }
        }
      },
      "dependsOn": [
        "app"
      ]
    },
    "platformSecretStore": {
