  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "15061394944901731255"
    }
  },
  "parameters": {
    "environment": {
      "type": "string",
      "metadata": {
        "description": "The ID of your Radius environment. Automatically injected by the rad CLI."
      }
    },
    "applicationName": {
      "type": "string",
      "defaultValue": "radiusclaim",
      "metadata": {
        "description": "Logical Radius application name for the RadiusClaim deployment."
      }
    },
    "containerRegistry": {
      "type": "string",
      "defaultValue": "ghcr.io/sovereignapp/radiusclaim",
      "metadata": {
        "description": "Container registry/repository prefix for RadiusClaim service images."
      }
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "phase1",
      "metadata": {
        "description": "Shared image tag for the service images used by the current environment."
      }
    },
    "deploymentTarget": {
      "type": "string",
      "defaultValue": "local",
      "metadata": {
        "description": "Deployment target label kept aligned to the active Radius environment."
      }
    },
    "daprBackings": {
      "type": "object",
      "defaultValue": {
        "stateStore": {
          "recipeName": "azure-blob-state",
          "type": "state.azure.blobstorage",
          "version": "v1"
        },
        "pubsub": {
          "recipeName": "azure-servicebus-pubsub",
          "type": "pubsub.azure.servicebus",
          "version": "v1"
        },
        "secretStore": {
          "recipeName": "azure-keyvault-secrets",
          "type": "secretstores.azure.keyvault",
          "version": "v1"
        }
      },
      "metadata": {
        "description": "Logical Dapr backing definitions. Override these per environment to swap providers without renaming statestore, pubsub, or platform-secrets."
      }
    }
  },
  "variables": {
    "radiusLocation": "global",
    "servicePort": 8080,
    "stateStoreAccountName": "[toLower(format('ce{0}', take(uniqueString(parameters('applicationName'), parameters('environment'), 'statestore'), 20)))]",
    "stateStoreContainerName": "expense-state",
    "pubsubNamespaceName": "[format('radiusclaim-{0}', take(uniqueString(parameters('applicationName'), parameters('environment'), 'pubsub'), 18))]",
    "notificationTopicName": "expense-notifications",
    "secretVaultName": "[format('ce-{0}', take(uniqueString(parameters('applicationName'), parameters('environment'), 'platform-secrets'), 20))]",
    "stateStoreBacking": "[parameters('daprBackings').stateStore]",
    "pubsubBacking": "[parameters('daprBackings').pubsub]",
    "secretStoreBacking": "[parameters('daprBackings').secretStore]"
  },
  "imports": {
    "radius": {
      "provider": "Radius",
      "version": "0.55"
    }
  },
  "resources": {
    "app": {
      "import": "radius",
      "type": "Applications.Core/applications@2023-10-01-preview",
      "properties": {
        "name": "[parameters('applicationName')]",
        "location": "[variables('radiusLocation')]",
        "properties": {
          "environment": "[parameters('environment')]"
        }
      }
    },
    "stateStore": {
      "import": "radius",
      "type": "Applications.Dapr/stateStores@2023-10-01-preview",
      "properties": {
        "name": "statestore",
        "location": "[variables('radiusLocation')]",
        "properties": {
          "environment": "[parameters('environment')]",
          "application": "[reference('app').id]",
          "resourceProvisioning": "recipe",
          "recipe": {
            "name": "[variables('stateStoreBacking').recipeName]",
            "parameters": {
              "storageAccountName": "[variables('stateStoreAccountName')]",
              "containerName": "[variables('stateStoreContainerName')]"
            }
          },
          "type": "[variables('stateStoreBacking').type]",
          "version": "[variables('stateStoreBacking').version]",
          "metadata": {
            "accountName": {
              "value": "[variables('stateStoreAccountName')]"
            },
            "containerName": {
              "value": "[variables('stateStoreContainerName')]"
            }
          }
        }
      },
      "dependsOn": [
        "app"
      ]
    },
    "pubsub": {
      "import": "radius",
      "type": "Applications.Dapr/pubSubBrokers@2023-10-01-preview",
      "properties": {
        "name": "pubsub",
