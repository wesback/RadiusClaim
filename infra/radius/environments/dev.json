{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "9161389777613108071"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Radius dev environment name."
      }
    },
    "kubernetesNamespace": {
      "type": "string",
      "defaultValue": "radiusclaim-dev",
      "metadata": {
        "description": "Kubernetes namespace used for the local Radius development slice."
      }
    },
    "azureProviderScope": {
      "type": "string",
      "defaultValue": "[resourceGroup().id]",
      "metadata": {
        "description": "Azure provider scope used by recipe-backed resources."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure location for backing resources created by recipes."
      }
    },
    "recipeRegistry": {
      "type": "string",
      "defaultValue": "ghcr.io/wesback/radiusclaim/recipes",
      "metadata": {
        "description": "OCI registry prefix that stores published Radius recipe artifacts for this repo."
      }
    },
    "recipeTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "OCI tag used when resolving published Radius recipe artifacts."
      }
    }
  },
  "imports": {
    "radius": {
      "provider": "Radius",
      "version": "0.55"
    }
  },
  "resources": {
    "env": {
      "import": "radius",
      "type": "Applications.Core/environments@2023-10-01-preview",
      "properties": {
        "name": "[parameters('environmentName')]",
        "properties": {
          "compute": {
            "kind": "kubernetes",
            "resourceId": "self",
            "namespace": "[parameters('kubernetesNamespace')]"
          },
          "providers": {
            "azure": {
              "scope": "[parameters('azureProviderScope')]"
            }
          },
          "recipes": {
            "Applications.Dapr/stateStores": {
              "azure-blob-state": {
                "templateKind": "bicep",
                "templatePath": "[format('{0}/state-store:{1}', parameters('recipeRegistry'), parameters('recipeTag'))]",
                "parameters": {
                  "location": "[parameters('location')]"
                }
              }
            },
            "Applications.Dapr/pubSubBrokers": {
              "azure-servicebus-pubsub": {
                "templateKind": "bicep",
                "templatePath": "[format('{0}/pubsub:{1}', parameters('recipeRegistry'), parameters('recipeTag'))]",
                "parameters": {
                  "location": "[parameters('location')]"
                }
              }
            },
            "Applications.Dapr/secretStores": {
              "azure-keyvault-secrets": {
                "templateKind": "bicep",
                "templatePath": "[format('{0}/secrets:{1}', parameters('recipeRegistry'), parameters('recipeTag'))]",
                "parameters": {
                  "location": "[parameters('location')]"
                }
              }
            }
          }
        }
      }
    }
  },
  "outputs": {
    "environmentModel": {
      "type": "object",
      "value": {
        "name": "[reference('env').name]",
        "computeTarget": "local-kubernetes",
        "namespace": "[parameters('kubernetesNamespace')]",
        "azureProviderScope": "[parameters('azureProviderScope')]",
        "recipeArtifacts": {
          "registry": "[parameters('recipeRegistry')]",
          "tag": "[parameters('recipeTag')]"
        },
        "recipes": {
          "stateStore": "azure-blob-state",
          "pubsub": "azure-servicebus-pubsub",
          "secretStore": "azure-keyvault-secrets"
        }
      }
    }
  }
}